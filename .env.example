# MineGuard AI Configuration
PROJECT_NAME="MineGuard AI"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security & JWT
SECRET_KEY="mineguard-super-secret-jwt-signing-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + PostGIS in Docker / Remote, or SQLite for local dev/testing)
# For PostgreSQL with PostGIS (Docker):
# DATABASE_URL="postgresql+psycopg://mineguard:mineguard_pass@localhost:5432/mineguard_db"
# For SQLite local mode (instant zero-friction testing):
DATABASE_URL="sqlite:///./mineguard.db"

# PostgreSQL Details (for Docker Compose)
POSTGRES_USER="mineguard"
POSTGRES_PASSWORD="mineguard_pass"
POSTGRES_DB="mineguard_db"
POSTGRES_PORT=5432

# CORS Configuration (comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000"

# File Upload & Document Processing
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15

# Tesseract OCR Configuration (leave empty to use PATH, or specify path if not in PATH)
# Example for Windows: TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
TESSERACT_CMD=""

# Google Earth Engine (Optional / Future integration)
GEE_SERVICE_ACCOUNT=""
GEE_PRIVATE_KEY_PATH=""

# Firebase Cloud Messaging (Optional / Future mobile push)
FIREBASE_CREDENTIALS_PATH=""
